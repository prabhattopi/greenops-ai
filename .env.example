# Google Gemini API Key (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_MODEL=gemini-3.5-flash-lite

# App URL (optional, defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional RunCloud API Integration Token / Webhook Secret for real cloud sync
RUNCLOUD_API_KEY=optional_runcloud_api_key
